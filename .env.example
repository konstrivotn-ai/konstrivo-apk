# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# ---------------------------------------------------------------
# Owner admin — local authority gate (R-001).
# NEVER place a real password here (not in this file, not in Git).
# Format: pbkdf2-sha256$<iterations>$<Base64(salt16)>$<Base64(hash32)>
# Generate locally (replace YOUR_STRONG_PASSWORD, keep result OUT of Git):
#   node -e "const c=require('crypto'),s=c.randomBytes(16);console.log('pbkdf2-sha256\$150000\$'+s.toString('base64')+'\$'+c.pbkdf2Sync(process.argv[1],s,150000,32,'sha256').toString('base64'))" YOUR_STRONG_PASSWORD
# The placeholder below is intentionally INVALID -> login FAILS CLOSED
# until a real credential is set in your local untracked `.env` file.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_CREDENTIAL=REPLACE_WITH_GENERATED_CREDENTIAL